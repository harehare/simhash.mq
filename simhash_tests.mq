import "simhash"
| import "ds"
| include "test"

def fails(f): try: f() catch: "failed";

def zeros(): repeat("0", 64);

def ones(): repeat("1", 64);

# A fingerprint made of `n` leading ones and zeros after it.
def leading_ones(n): repeat("1", n) + repeat("0", 64 - n);

# A deterministic pseudo-random fingerprint for seed i, built from an MD5 digest.
def random_fp(i):
  simhash::fingerprint_tokens(["seed" + to_string(i), "salt" + to_string(i * 7 + 1), "x" + to_string(i % 5)])
end

# Flips the first `n` bits of a fingerprint.
def flip(fp, n):
  join(map(range(0, 63), fn(i): if (i < n): (if (fp[i] == "1"): "0" else: "1") else: fp[i];), "")
end

def is_bit_string(s): len(s) == 64 && len(filter(to_array(s), fn(c): c == "0" || c == "1";)) == 64;

# =========================================================================
# tokenize and shingles
# =========================================================================

def test_tokenize():
  assert_eq(simhash::tokenize("Hello, World! x_y"), ["hello", "world", "x", "y"])
  | assert_eq(simhash::tokenize(""), [])
end

def test_shingles_join_consecutive_words():
  assert_eq(simhash::shingles(["a", "b", "c", "d"], 2), ["a b", "b c", "c d"])
  | assert_eq(simhash::shingles(["a", "b", "c", "d"], 3), ["a b c", "b c d"])
end

def test_shingles_fall_back_to_the_tokens():
  assert_eq(simhash::shingles(["a", "b"], 3), ["a", "b"])
  | assert_eq(simhash::shingles(["a", "b", "c"], 1), ["a", "b", "c"])
  | assert_eq(simhash::shingles([], 2), [])
end

def test_shingles_of_exactly_n_tokens_give_one_shingle():
  assert_eq(simhash::shingles(["a", "b", "c"], 3), ["a b c"])
end

# =========================================================================
# fingerprint
# =========================================================================

def test_fingerprint_is_64_bits():
  assert_true(is_bit_string(simhash::fingerprint("the quick brown fox")))
  | assert_true(is_bit_string(simhash::fingerprint("x")))
end

def test_fingerprint_is_deterministic():
  assert_eq(simhash::fingerprint("the quick brown fox"), simhash::fingerprint("the quick brown fox"))
end

def test_fingerprint_ignores_case_and_punctuation():
  assert_eq(simhash::fingerprint("The Quick, Brown Fox!"), simhash::fingerprint("the quick brown fox"))
end

def test_fingerprint_ignores_word_order():
  assert_eq(simhash::fingerprint("fox brown quick the"), simhash::fingerprint("the quick brown fox"))
end

def test_fingerprint_of_nothing_is_all_zeros():
  assert_eq(simhash::fingerprint(""), zeros())
  | assert_eq(simhash::fingerprint("!!!"), zeros())
  | assert_eq(simhash::fingerprint_tokens([]), zeros())
end

def test_fingerprint_of_one_word_is_the_start_of_its_md5():
  let fp = simhash::fingerprint("cat")
  | assert_true(is_bit_string(fp))
  | assert_eq(fp[0:8], "11010000")
end

def test_fingerprint_weights_repeated_words():
  let heavy = simhash::fingerprint_tokens(["cat", "cat", "cat", "dog"])
  | assert_eq(heavy, simhash::fingerprint_tokens(["cat"]))
end

def test_fingerprint_shingles_reflect_word_order():
  assert_ne(simhash::fingerprint_shingles("fox brown quick the", 2), simhash::fingerprint_shingles("the quick brown fox", 2))
end

def test_fingerprint_shingles_of_one_is_the_plain_fingerprint():
  assert_eq(simhash::fingerprint_shingles("the quick brown fox", 1), simhash::fingerprint("the quick brown fox"))
end

def test_similar_texts_are_closer_than_unrelated_ones():
  let a = simhash::fingerprint("the quick brown fox jumps over the lazy dog near the river bank today")
  | let b = simhash::fingerprint("the quick brown fox jumped over the lazy dog near the river bank today")
  | let c = simhash::fingerprint("completely unrelated sentence regarding databases indexing and query planning")
  | assert_true(simhash::distance(a, b) < simhash::distance(a, c))
  | assert_true(simhash::distance(a, b) <= 12)
end

# =========================================================================
# distance and near
# =========================================================================

def test_distance_counts_differing_positions():
  assert_eq(simhash::distance(zeros(), zeros()), 0)
  | assert_eq(simhash::distance(zeros(), ones()), 64)
  | assert_eq(simhash::distance(leading_ones(5), zeros()), 5)
  | assert_eq(simhash::distance(leading_ones(5), leading_ones(9)), 4)
end

def test_distance_is_symmetric():
  let a = random_fp(1)
  | let b = random_fp(2)
  | assert_eq(simhash::distance(a, b), simhash::distance(b, a))
end

def test_distance_satisfies_the_triangle_inequality():
  let a = random_fp(1)
  | let b = random_fp(2)
  | let c = random_fp(3)
  | assert_true(simhash::distance(a, c) <= simhash::distance(a, b) + simhash::distance(b, c))
end

def test_distance_rejects_different_lengths():
  assert_eq(fails(fn(): simhash::distance("0101", "01");), "failed")
end

def test_near():
  assert_true(simhash::near(leading_ones(3), zeros(), 3))
  | assert_false(simhash::near(leading_ones(4), zeros(), 3))
  | assert_true(simhash::near(zeros(), zeros(), 0))
end

# =========================================================================
# clusters
# =========================================================================

def test_clusters_group_identical_texts():
  assert_eq(simhash::clusters(["alpha beta", "gamma delta", "alpha beta"], 0), [[0, 2], [1]])
end

def test_clusters_group_near_duplicates():
  let texts = [
    "the quick brown fox jumps over the lazy dog near the river bank today",
    "completely unrelated sentence regarding databases indexing and query planning",
    "the quick brown fox jumped over the lazy dog near the river bank today",
    "another unrelated line about cooking pasta with tomatoes and fresh basil leaves"
  ]
  | assert_eq(simhash::clusters(texts, 12), [[0, 2], [1], [3]])
end

def test_clusters_of_no_texts():
  assert_eq(simhash::clusters([], 3), [])
end

def test_clusters_of_one_text():
  assert_eq(simhash::clusters(["only"], 3), [[0]])
end

def test_clusters_with_distance_zero_only_join_exact_matches():
  let a = zeros()
  | let b = leading_ones(1)
  | assert_eq(simhash::cluster_fingerprints([a, b, a], 0), [[0, 2], [1]])
end

def test_clusters_with_distance_one_join_neighbours():
  assert_eq(simhash::cluster_fingerprints([zeros(), leading_ones(1), leading_ones(2)], 1), [[0, 1, 2]])
end

def test_clusters_chain_through_intermediate_fingerprints():
  assert_eq(simhash::cluster_fingerprints([zeros(), leading_ones(2), leading_ones(4)], 2), [[0, 1, 2]])
end

def test_clusters_keep_fingerprints_beyond_the_distance_apart():
  assert_eq(simhash::cluster_fingerprints([zeros(), leading_ones(5)], 4), [[0], [1]])
end

def test_clusters_with_maximum_distance_join_everything():
  assert_eq(simhash::cluster_fingerprints([zeros(), ones(), leading_ones(30)], 64), [[0, 1, 2]])
end

def test_clusters_reject_a_distance_out_of_range():
  assert_eq(fails(fn(): simhash::cluster_fingerprints([zeros()], -1);), "failed")
  | assert_eq(fails(fn(): simhash::cluster_fingerprints([zeros()], 65);), "failed")
end

def test_clusters_are_ordered_by_smallest_index():
  assert_eq(simhash::cluster_fingerprints([ones(), zeros(), ones(), zeros()], 0), [[0, 2], [1, 3]])
end

# The sliced search must find exactly the pairs a full comparison finds.
def brute_force(fps, d):
  var uf = ds::unionfind::new(len(fps))
  | var i = 0
  | let _ = while (i < len(fps)):
      var j = i + 1
      | let _ = while (j < len(fps)):
          uf = if (simhash::distance(fps[i], fps[j]) <= d): ds::unionfind::union(uf, i, j) else: uf
          | j = j + 1
        end
      | i = i + 1
    end
  | ds::unionfind::groups(uf)
end

# Fingerprints that sit in a few tight groups, so there is something to merge at every distance.
def spread_fps():
  let bases = map(range(0, 5), fn(i): random_fp(i * 11);)
  | map(range(0, 29), fn(i): flip(bases[i % 6], (i * 5) % 14);)
end

def test_clusters_match_a_full_comparison():
  let fps = spread_fps()
  | let _ = foreach(d, [0, 1, 2, 3, 5, 8, 13, 20, 40]): assert_eq(simhash::cluster_fingerprints(fps, d), brute_force(fps, d));
  | None
end

def test_clusters_match_a_full_comparison_on_unrelated_fingerprints():
  let fps = map(range(0, 24), fn(i): random_fp(i);)
  | let _ = foreach(d, [0, 16, 20, 22, 23, 24, 25, 26, 30]): assert_eq(simhash::cluster_fingerprints(fps, d), brute_force(fps, d));
  | None
end
