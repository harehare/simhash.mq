import "minhash"
| import "ds"
| include "test"

def fails(f): try: f() catch: "failed";

def texts():
  [
    "the quick brown fox jumps over the lazy dog near the river bank today",
    "completely unrelated sentence regarding databases indexing and query planning",
    "the quick brown fox jumped over the lazy dog near the river bank today",
    "another unrelated line about cooking pasta with tomatoes and fresh basil leaves"
  ]
end

# =========================================================================
# signature
# =========================================================================

def test_signature_has_k_positions():
  assert_eq(len(minhash::signature("the quick brown fox", 16)), 16)
  | assert_eq(len(minhash::signature("x", 1)), 1)
end

def test_signature_is_deterministic():
  assert_eq(minhash::signature("the quick brown fox", 32), minhash::signature("the quick brown fox", 32))
end

def test_signature_ignores_order_and_repeats():
  assert_eq(minhash::signature("fox brown quick", 32), minhash::signature("quick quick brown fox fox", 32))
end

def test_signature_shingles_reflect_order():
  assert_true(minhash::signature_shingles("a b c d e f", 64, 2) != minhash::signature_shingles("f e d c b a", 64, 2))
end

def test_signature_rejects_a_length_below_one():
  assert_eq(fails(fn(): minhash::signature("a", 0);), "failed")
end

def test_signature_of_no_tokens_matches_itself():
  assert_eq(minhash::signature("", 8), minhash::signature("...", 8))
end

# =========================================================================
# similarity
# =========================================================================

def test_similarity_of_equal_texts_is_one():
  assert_eq(minhash::similarity(minhash::signature("a b c", 32), minhash::signature("c b a", 32)), 1)
end

def test_similarity_of_disjoint_texts_is_zero():
  assert_eq(minhash::similarity(minhash::signature("a b c d", 128), minhash::signature("w x y z", 128)), 0)
end

def test_similarity_estimates_jaccard():
  # {a..j} and {e..n} share 6 of 14 words: Jaccard 0.4286 up to the estimate's noise
  let s = minhash::similarity(minhash::signature("a b c d e f g h i j", 512), minhash::signature("e f g h i j k l m n", 512))
  | assert_true(s > 0.3 && s < 0.55)
end

def test_similarity_rejects_signatures_of_different_lengths():
  assert_eq(fails(fn(): minhash::similarity([1, 2], [1]);), "failed")
end

def test_near():
  let t = texts()
  | assert_true(minhash::near(minhash::signature(t[0], 128), minhash::signature(t[2], 128), 0.5))
  | assert_true(!minhash::near(minhash::signature(t[0], 128), minhash::signature(t[1], 128), 0.5))
end

# =========================================================================
# clusters
# =========================================================================

def test_clusters_group_near_duplicates():
  assert_eq(minhash::clusters(texts(), 0.5, 128), [[0, 2], [1], [3]])
end

def test_clusters_of_nothing():
  assert_eq(minhash::clusters([], 0.5, 16), [])
end

def test_clusters_group_identical_texts():
  assert_eq(minhash::clusters(["a b c", "x y z", "a b c", "a b c"], 0.9, 32), [[0, 2, 3], [1]])
end

def test_clusters_of_texts_with_no_words_share_a_group():
  assert_eq(minhash::clusters(["", "!!", "a b"], 0.5, 16), [[0, 1], [2]])
end

def test_clusters_at_similarity_one_need_equal_signatures():
  assert_eq(minhash::clusters(["a b c", "c b a", "a b d"], 1, 64), [[0, 1], [2]])
end

def test_clusters_at_similarity_zero_join_everything():
  assert_eq(minhash::clusters(["a b", "c d", "e f"], 0, 8), [[0, 1, 2]])
end

def test_clusters_reject_a_similarity_out_of_range():
  assert_eq(fails(fn(): minhash::clusters(["a"], 1.5, 8);), "failed")
  | assert_eq(fails(fn(): minhash::clusters(["a"], -0.1, 8);), "failed")
end

def test_clusters_chain_through_a_middle_text():
  let base = "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu"
  | let mid = "alpha beta gamma delta epsilon zeta eta theta iota kappa nu xi"
  | let far = "alpha beta gamma delta epsilon zeta omicron pi rho sigma nu xi"
  | assert_eq(minhash::clusters([base, mid, far], 0.4, 256), [[0, 1, 2]])
end
