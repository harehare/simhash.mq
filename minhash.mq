import "ds"
| import "simhash"

# Near-duplicate detection with MinHash: a signature of `k` numbers where the share of positions two
# signatures agree on estimates the Jaccard similarity of the texts' word sets.
#
# A signature is an array of `k` numbers, each the smallest value of one seeded `hash` over the
# tokens. Unlike SimHash, repeated tokens count once and only the set of tokens matters.

# The value of a position when there are no tokens, one above any hash value.
def _empty(): 4294967296;

# Returns the signature of an array of tokens, with `k` positions. No tokens give `k` copies of the
# same value, so they all match each other.
def signature_tokens(tokens, k):
  if (k < 1):
    error("minhash: signature length must be at least 1: " + to_string(k))
  else:
    if (is_empty(tokens)):
      repeat([_empty()], k)
    else:
      do
        let distinct = keys(dict(map(tokens, fn(t): [t, 1];)))
        | map(range(1, k), fn(i): sort(map(distinct, fn(t): hash(t, i) % 4294967296;))[0];)
      end
end

# Returns the signature of a text, word by word.
def signature(text, k): signature_tokens(simhash::tokenize(text), k);

# Returns the signature of a text over runs of `n` words, which also reflects word order.
def signature_shingles(text, k, n): signature_tokens(simhash::shingles(simhash::tokenize(text), n), k);

# Returns the share of positions where two signatures agree: an estimate of the Jaccard similarity.
def similarity(a, b):
  if (len(a) != len(b)):
    error("minhash: signatures differ in length: " + to_string(len(a)) + " and " + to_string(len(b)))
  else:
    do
      var same = 0
      | var i = 0
      | let n = len(a)
      | let _ = while (i < n):
          same = same + if (a[i] == b[i]): 1 else: 0
          | i = i + 1
        end
      | same / n
    end
end

# Returns true if the estimated similarity of two signatures is at least `min_similarity`.
def near(a, b, min_similarity): similarity(a, b) >= min_similarity;

# Returns a signature as bytes: four per position, then a 255 that keeps a run of equal positions
# apart from the next one. A value above 2^32 - 1, such as the one for no tokens, packs as 2^32 - 1.
def _encode(sig): fold(sig, to_bytes([]), fn(acc, v): acc + pack("u32be", v) + to_bytes([255]););

# Returns the number of positions where two signatures given as bytes agree. Xoring them gives four
# 0 bytes for a position where they agree, and `mask` turns the 255 after each position back into
# 255, so only a whole position can be taken out and none is read across two.
def _agreeing(a, b, mask):
  do
    let x = xor(xor(a, b), mask)
    | (len(x) - len(replace(x, to_bytes([0, 0, 0, 0, 255]), to_bytes([])))) / 5
  end
end

# Returns how many positions go in one band: the largest divisor `r` of `k` for which a pair of
# similarity `threshold` is a candidate in at least about half of the cases, that is
# (1 / bands)^(1 / r) <= threshold. A smaller `r` finds more pairs and compares more of them.
def _rows(k, threshold):
  fold(range(1, k), 1, fn(best, r):
    if (k % r == 0 && pow(r / k, 1 / r) <= threshold): r else: best;
  )
end

# Groups signatures whose similarity chains at `min_similarity` or more, and returns the groups as
# arrays of indexes, ordered by their smallest index.
#
# The signatures are cut into bands, and only those that agree on a whole band are compared, so a
# pair that is only just similar enough can be missed. Every pair that is compared is checked, so
# no group joins signatures that are not chained by similar pairs.
def cluster_signatures(sigs, min_similarity):
  if (min_similarity < 0 || min_similarity > 1):
    error("minhash: minimum similarity must be between 0 and 1: " + to_string(min_similarity))
  else:
    do
      let n = len(sigs)
      | var uf = ds::unionfind::new(n)
      | var first = {}
      | var reps = []
      | var i = 0
      | let _ = while (i < n):
          let key = join(sigs[i], ",")
          | let _ = if (has(first, key)):
              uf = ds::unionfind::union(uf, i, first[key])
            else:
              do
                first = set(first, key, i)
                | reps += [i]
              end
          | i = i + 1
        end
      | let m = len(reps)
      | let k = if (n == 0): 1 else: len(sigs[0])
      | let enc = map(sigs, _encode)
      | let mask = _encode(map(range(1, k), fn(i): 0;))
      | let rows = _rows(k, min_similarity)
      | let bands = k / rows
      | var b = 0
      | let _ = while (min_similarity == 0 && b < m - 1):
          uf = ds::unionfind::union(uf, reps[b], reps[b + 1])
          | b = b + 1
        end
      | b = 0
      | let _ = while (min_similarity > 0 && min_similarity < 1 && b < bands):
          let keyed = sort(map(reps, fn(r): [join(slice(sigs[r], b * rows, (b + 1) * rows), ","), r];))
          | var s = 0
          | let _ = while (s < m):
              var e = s
              | let _ = while (e < m && keyed[e][0] == keyed[s][0]):
                  e = e + 1
                end
              | var p = s
              | let _ = while (p < e):
                  let ip = keyed[p][1]
                  | let ep = enc[ip]
                  | var q = p + 1
                  | let _ = while (q < e):
                      let iq = keyed[q][1]
                      | uf = if (_agreeing(ep, enc[iq], mask) / k >= min_similarity): ds::unionfind::union(uf, ip, iq) else: uf
                      | q = q + 1
                    end
                  | p = p + 1
                end
              | s = e
            end
          | b = b + 1
        end
      | ds::unionfind::groups(uf)
    end
end

# Groups texts whose signatures chain at `min_similarity` or more, as arrays of indexes ordered by
# their smallest index. Texts that match nothing come back as groups of one.
def clusters(texts, min_similarity, k): cluster_signatures(map(texts, fn(t): signature(t, k);), min_similarity);
