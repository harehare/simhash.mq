import "ds"

# Near-duplicate detection with SimHash: a 64-bit fingerprint where similar texts get fingerprints
# that differ in few bits.
#
# A fingerprint is a string of 64 characters, each "0" or "1". The distance between two
# fingerprints is the number of positions where they differ.

def _count(tokens):
  var counts = {}
  | var i = 0
  | let n = len(tokens)
  | let _ = while (i < n):
      let t = tokens[i]
      | counts = set(counts, t, if (has(counts, t)): counts[t] + 1 else: 1)
      | i = i + 1
    end
  | counts
end

# Splits text into lowercase words on anything that is not a letter or a digit.
def tokenize(text):
  filter(split(downcase(text), "[\\W_]+"), fn(s): !is_empty(s);)
end

# Returns the runs of `n` consecutive tokens joined by a space, or the tokens themselves when there
# are fewer than `n`.
def shingles(tokens, n):
  if (n <= 1 || len(tokens) < n):
    tokens
  else:
    map(range(0, len(tokens) - n), fn(i): join(slice(tokens, i, i + n), " ");)
end

# Votes for the 64 bits of a non-empty array of tokens, 32 bits from each of two seeded `hash`
# values. Counting 64 bits one by one is slow, so several counters share one number: a group of
# `per` bits is looked up in a table that spreads them into fields of `width` bits, and adding such
# numbers counts all of the group's bits at once. A field never exceeds the number of tokens, which
# is below 2^width, so the fields do not carry into each other.
def _vote(tokens, total):
  let width = bit_length(total)
  | let per = min(floor(53 / width), 6)
  | let groups = ceil(32 / per)
  | let size = pow(2, per)
  | let spread = fold(range(0, per - 1), [0], fn(table, j): table + map(table, fn(v): v + pow(2, width * j););)
  | let divisors = map(range(0, groups - 1), fn(g): pow(2, per * g);)
  | let weights = _count(tokens)
  | let terms = keys(weights)
  | var counts = map(range(0, 2 * groups - 1), fn(i): 0;)
  | var i = 0
  | let _ = while (i < len(terms)):
      let high = hash(terms[i], 1) % 4294967296
      | let low = hash(terms[i], 2) % 4294967296
      | let w = weights[terms[i]]
      | var g = 0
      | let _ = while (g < groups):
          counts[g] = counts[g] + w * spread[floor(high / divisors[g]) % size]
          | counts[groups + g] = counts[groups + g] + w * spread[floor(low / divisors[g]) % size]
          | g = g + 1
        end
      | i = i + 1
    end
  | let shifts = map(range(0, per - 1), fn(j): pow(2, width * j);)
  | let modulus = pow(2, width)
  | join(map(range(0, 63), fn(k):
      let b = k % 32
      | let field = floor(counts[(k - b) / 32 * groups + floor(b / per)] / shifts[b % per]) % modulus
      | if (field * 2 > total): "1" else: "0";
    ), "")
end

# Returns the fingerprint of an array of tokens. A token that occurs more often pulls harder on the
# bits. No tokens give 64 zeros.
def fingerprint_tokens(tokens): if (is_empty(tokens)): repeat("0", 64) else: _vote(tokens, len(tokens));

# Returns the fingerprint of a text, word by word.
def fingerprint(text): fingerprint_tokens(tokenize(text));

# Returns the fingerprint of a text over runs of `n` words, which also reflects word order.
def fingerprint_shingles(text, n): fingerprint_tokens(shingles(tokenize(text), n));

# Returns the number of positions where two fingerprints differ.
def distance(a, b):
  if (len(a) != len(b)):
    error("simhash: fingerprints differ in length: " + to_string(len(a)) + " and " + to_string(len(b)))
  else:
    do
      var d = 0
      | var i = 0
      | let n = len(a)
      | let _ = while (i < n):
          d = d + if (a[i] != b[i]): 1 else: 0
          | i = i + 1
        end
      | d
    end
end

# Returns true if two fingerprints differ in at most `max_distance` positions.
def near(a, b, max_distance): distance(a, b) <= max_distance;

# Groups fingerprints whose distance chains within `max_distance`, and returns the groups as arrays
# of indexes, ordered by their smallest index.
#
# Two fingerprints within `max_distance` of each other always share one of `max_distance + 1`
# slices of their bits, so only fingerprints that share a slice are compared.
def cluster_fingerprints(fps, max_distance):
  if (max_distance < 0 || max_distance > 64):
    error("simhash: max distance must be between 0 and 64: " + to_string(max_distance))
  else:
    do
      let n = len(fps)
      | var uf = ds::unionfind::new(n)
      | var first = {}
      | var reps = []
      | var i = 0
      | let _ = while (i < n):
          let fp = fps[i]
          | let _ = if (has(first, fp)):
              uf = ds::unionfind::union(uf, i, first[fp])
            else:
              do
                first = set(first, fp, i)
                | reps += [i]
              end
          | i = i + 1
        end
      | let m = len(reps)
      | let blocks = if (max_distance >= 64): 1 else: max_distance + 1
      | var b = 0
      | let _ = while (max_distance > 0 && b < blocks):
          let lo = floor(b * 64 / blocks)
          | let hi = floor((b + 1) * 64 / blocks)
          | let keyed = sort(map(reps, fn(r): [if (max_distance >= 64): "" else: fps[r][lo:hi], r];))
          | var s = 0
          | let _ = while (s < m):
              var e = s
              | let _ = while (e < m && keyed[e][0] == keyed[s][0]):
                  e = e + 1
                end
              | var p = s
              | let _ = while (p < e):
                  var q = p + 1
                  | let _ = while (q < e):
                      uf = if (distance(fps[keyed[p][1]], fps[keyed[q][1]]) <= max_distance): ds::unionfind::union(uf, keyed[p][1], keyed[q][1]) else: uf
                      | q = q + 1
                    end
                  | p = p + 1
                end
              | s = e
            end
          | b = b + 1
        end
      | ds::unionfind::groups(uf)
    end
end

# Groups texts whose fingerprints chain within `max_distance`, as arrays of indexes ordered by their
# smallest index. Texts that match nothing come back as groups of one.
def clusters(texts, max_distance): cluster_fingerprints(map(texts, fn(t): fingerprint(t);), max_distance);
